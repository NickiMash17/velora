APP_NAME=velora-backend
ENVIRONMENT=local

# Matches docker-compose.yml's postgres/redis service defaults.
#
# DATABASE_URL is the app's own runtime connection — velora_app, a
# non-superuser role RLS actually applies to (see app/shared/config.py
# and alembic/versions/aa3e8dcefd79_*.py for why). It only exists after
# `alembic upgrade head` has run at least once, since the migration
# itself creates the role.
DATABASE_URL=postgresql+asyncpg://velora_app:velora_app_dev_only@localhost:5433/velora
# MIGRATIONS_DATABASE_URL is the table-owning superuser role — used only
# by Alembic to run DDL. Never used by the running application.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://velora:velora@localhost:5433/velora
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=DEBUG

CORS_ALLOW_ORIGINS=["http://localhost:3000"]
